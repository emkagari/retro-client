#!/usr/bin/env bash
# The project's tools in Docker: nothing to install but Docker (Linux, macOS).
#
#   ./retro build                 src/ → build/loader.swf
#   ./retro play                  build, package from your official client, start the game
#   ./retro dev                   the same with hot reload and auto login (Ctrl+C to stop)
#   ./retro editor                the sprite editor: http://localhost:4777
#   ./retro release v1.49.5-r1    prepare a release (dist/release/)
#   ./retro help                  every command
#
# The image (Node, Java, FFDec) is built on first use, and again when the
# Dockerfile changes. The repository is mounted at /work; your official client
# (retro.local.json's "upstream") and your local overlay ("overlay") at the same
# paths. The game runs here, not in Docker.
#
# Written for macOS's bash 3.2 too: an empty array is expanded as
# ${a[@]+"${a[@]}"}, since "${a[@]}" is an unbound variable there under set -u.
set -euo pipefail
cd "$(dirname "$0")"
IMAGE=retro-client
# The packaged client (tools/package.mjs), its executable and its retroclient/ folder.
if [ "$(uname -s)" = Darwin ]; then
  PLATFORM=mac
  client="dist/mac/Dofus Retro.app"
  exe="Contents/MacOS/Dofus Retro"
  retroclient="Contents/Resources/app/retroclient"
else
  PLATFORM=linux
  client="dist/linux"
  exe="dofus1electron"
  retroclient="resources/app/retroclient"
fi

docker build -t "$IMAGE" .

# The official client and the local overlay, mounted where retro.local.json says they are.
mounts=()
if [ -f retro.local.json ]; then
  local_path() { docker run --rm -v "$PWD:/work" --entrypoint node "$IMAGE" /work/tools/local.mjs "$1"; }
  upstream=$(local_path "upstream.$PLATFORM")
  if [ -n "$upstream" ] && [ -d "$upstream" ]; then mounts+=(-v "$upstream:$upstream:ro"); fi
  overlay=$(local_path overlay)
  if [ -n "$overlay" ] && [ -d "$overlay" ]; then mounts+=(-v "$overlay:$overlay:ro"); fi
fi

tty=(); if [ -t 0 ] && [ -t 1 ]; then tty=(-it); fi
run() { docker run --rm ${tty[@]+"${tty[@]}"} --user "$(id -u):$(id -g)" -v "$PWD:/work" ${mounts[@]+"${mounts[@]}"} "$@"; }

case "${1:-help}" in
  play)
    run "$IMAGE" package --platform "$PLATFORM"
    cd "$client" && exec "./$exe"
    ;;
  dev)
    shift
    name="retro-dev-$$"
    hot="$client/$retroclient/hot/version.txt"
    rm -f "$hot"
    # The watcher in Docker (detached), the game here once the first build is packaged.
    docker run -d --name "$name" --user "$(id -u):$(id -g)" -v "$PWD:/work" ${mounts[@]+"${mounts[@]}"} \
      "$IMAGE" dev --platform "$PLATFORM" --no-run "$@"
    trap 'docker rm -f "$name"' EXIT
    docker logs -f "$name" &
    until [ -f "$hot" ]; do
      if [ "$(docker inspect -f '{{.State.Running}}' "$name")" != "true" ]; then exit 1; fi
      sleep 1
    done
    (cd "$client" && "./$exe" &)
    wait
    ;;
  editor)
    # The editor's page, served from Docker on this machine's port 4777.
    run -p 127.0.0.1:4777:4777 -e RETRO_EDITOR_HOST=0.0.0.0 "$IMAGE" "$@"
    ;;
  *)
    run "$IMAGE" "$@"
    ;;
esac
